{
  "manifest_version": 3,
  "name": "Profile Switcher",
  "version": "0.2.0",
  "description": "Arc-style one-click switching between Chrome profiles, from a small bar in the corner of every page.",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "identity",
    "identity.email"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Switch profile",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-dock": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Show / hide the profile bar on pages"
    },
    "next-profile": {
      "suggested_key": {
        "default": "Alt+Shift+Period"
      },
      "description": "Switch to the next profile"
    },
    "prev-profile": {
      "suggested_key": {
        "default": "Alt+Shift+Comma"
      },
      "description": "Switch to the previous profile"
    }
  }
}
